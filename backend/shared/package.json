{
  "name": "@greennewstracker/shared",
  "version": "1.0.0",
  "description": "GreenNewsTracker shared utilities, types, and database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
