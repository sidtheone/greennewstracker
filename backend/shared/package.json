    "clean": "rm -rf dist",
    "test": "vitest run --pool=vmThreads"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sqlite3": "^3.1.11",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
